{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nba-analysis:observation:1.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "team_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
    },
    "game_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
    },
    "game_date": {
      "type": "string",
      "format": "date"
    },
    "metric_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
    },
    "unit": {
      "type": "string",
      "minLength": 1
    },
    "denominator": {
      "type": "string",
      "minLength": 1
    },
    "value": {
      "type": [
        "number",
        "null"
      ]
    },
    "value_status": {
      "enum": [
        "present",
        "missing",
        "unavailable",
        "not_applicable"
      ]
    },
    "verification_status": {
      "enum": [
        "unverified",
        "verified",
        "failed"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_row": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "schema_version",
    "team_id",
    "game_id",
    "game_date",
    "metric_id",
    "unit",
    "denominator",
    "value",
    "value_status",
    "verification_status",
    "reason",
    "source_row"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "value_status": {
            "const": "present"
          }
        }
      },
      "then": {
        "properties": {
          "value": {
            "type": "number"
          }
        }
      },
      "else": {
        "properties": {
          "value": {
            "type": "null"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    }
  ]
}
